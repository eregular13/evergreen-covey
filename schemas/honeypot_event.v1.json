{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evergreen.local/schemas/honeypot_event.v1.json",
  "title": "honeypot_event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "observed_at",
    "sensor_id",
    "src_ip",
    "dst_ip",
    "dst_port",
    "protocol",
    "action"
  ],
  "properties": {
    "schema": { "const": "honeypot_event.v1" },
    "event_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 10 },
    "sensor_id": { "type": "string", "minLength": 1 },
    "src_ip": { "type": "string", "minLength": 3 },
    "src_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "dst_ip": { "type": "string", "minLength": 3 },
    "dst_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocol": { "enum": ["tcp", "udp", "icmp"] },
    "action": {
      "enum": ["connect", "banner", "auth_attempt", "payload", "close"]
    },
    "session_id": { "type": "string", "minLength": 1 },
    "service": { "type": "string" },
    "payload_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
