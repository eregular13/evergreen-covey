{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evergreen.local/schemas/session_summary.v1.json",
  "title": "session_summary.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "session_id",
    "sensor_id",
    "started_at",
    "ended_at",
    "src_ip",
    "dst_port",
    "protocol",
    "event_count"
  ],
  "properties": {
    "schema": { "const": "session_summary.v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "sensor_id": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 10 },
    "ended_at": { "type": "string", "minLength": 10 },
    "src_ip": { "type": "string", "minLength": 3 },
    "dst_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "protocol": { "enum": ["tcp", "udp", "icmp"] },
    "event_count": { "type": "integer", "minimum": 1 },
    "first_action": { "type": "string" },
    "last_action": { "type": "string" },
    "outcome": { "enum": ["closed", "timeout", "reset"] }
  }
}
